{
  "$schema": "../config.schema.json",
  "name": "Voxel game Evolution",
  "description": "相对 Shadertoy 原版没有任何改动。原 shader 的 rayCast() 里 rayCastResults 的 grass 字段从没被赋值，其值未定义；桌面 OpenGL 驱动下会读到非零的寄存器残留值（表现为 true），使第 812 行 if(res.hit && !res.grass) 恒为假，非草叶像素拿不到材质色而整片渲染成黑色。Shadertoy 的 WebGL 后端保证未初始化变量为 0，所以那边看不出问题——本程序经 ANGLE 翻译时也补齐了这条语义，故无需再手改源码。",
  "common": "common.glsl",
  "passes": [
    {
      "name": "BufferA",
      "shader": "buffera.glsl",
      "channels": {
        "0": {
          "type": "buffer",
          "source": "BufferA",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "1": {
          "type": "buffer",
          "source": "BufferB",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "2": {
          "type": "keyboard"
        },
        "3": {
          "type": "buffer",
          "source": "BufferD",
          "filter": "linear",
          "wrap": "clamp"
        }
      }
    },
    {
      "name": "BufferB",
      "shader": "bufferb.glsl",
      "channels": {
        "0": {
          "type": "buffer",
          "source": "BufferA",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "1": {
          "type": "buffer",
          "source": "BufferB",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "2": {
          "type": "buffer",
          "source": "BufferC",
          "filter": "nearest",
          "wrap": "clamp"
        }
      }
    },
    {
      "name": "BufferC",
      "shader": "bufferc.glsl",
      "channels": {
        "0": {
          "type": "buffer",
          "source": "BufferA",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "1": {
          "type": "buffer",
          "source": "BufferB",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "2": {
          "type": "buffer",
          "source": "BufferC",
          "filter": "nearest",
          "wrap": "clamp"
        }
      }
    },
    {
      "name": "BufferD",
      "shader": "bufferd.glsl",
      "channels": {
        "0": {
          "type": "buffer",
          "source": "BufferA",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "1": {
          "type": "buffer",
          "source": "BufferB",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "2": {
          "type": "buffer",
          "source": "BufferC",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "3": {
          "type": "buffer",
          "source": "BufferD",
          "filter": "linear",
          "wrap": "clamp"
        }
      }
    },
    {
      "name": "Image",
      "shader": "image.glsl",
      "channels": {
        "0": {
          "type": "buffer",
          "source": "BufferA",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "1": {
          "type": "buffer",
          "source": "BufferB",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "2": {
          "type": "buffer",
          "source": "BufferC",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "3": {
          "type": "buffer",
          "source": "BufferD",
          "filter": "linear",
          "wrap": "clamp"
        }
      }
    }
  ]
}