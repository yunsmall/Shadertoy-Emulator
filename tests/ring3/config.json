{
  "$schema": "../../shaders/config.schema.json",
  "name": "Three Node Ring Self Test",
  "width": 64,
  "height": 64,
  "passes": [
    {
      "name": "BufferA",
      "shader": "inc.glsl",
      "channels": { "0": { "type": "buffer", "source": "BufferC" } }
    },
    {
      "name": "BufferB",
      "shader": "inc.glsl",
      "channels": { "0": { "type": "buffer", "source": "BufferA" } }
    },
    {
      "name": "BufferC",
      "shader": "inc.glsl",
      "channels": { "0": { "type": "buffer", "source": "BufferB" } }
    },
    {
      "name": "Image",
      "shader": "show.glsl",
      "channels": {
        "0": { "type": "buffer", "source": "BufferA" },
        "1": { "type": "buffer", "source": "BufferB" },
        "2": { "type": "buffer", "source": "BufferC" }
      }
    }
  ]
}
